{
  "manifest_version": 3,
  "name": "FeelCV",
  "version": "3.0",
  "description": "AI-powered resume autofill assistant for job applications.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*"
  ],

  "optional_host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon48.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://greenhouse.io/*", "*://*.greenhouse.io/*",
        "*://lever.co/*", "*://*.lever.co/*",
        "*://ashby.io/*", "*://*.ashby.io/*",
        "*://ashbyhq.com/*", "*://*.ashbyhq.com/*",
        "*://workday.com/*", "*://*.workday.com/*",
        "*://bamboohr.com/*", "*://*.bamboohr.com/*",
        "*://smartrecruiters.com/*", "*://*.smartrecruiters.com/*",
        "*://jobvite.com/*", "*://*.jobvite.com/*",
        "*://icims.com/*", "*://*.icims.com/*",
        "*://taleo.net/*", "*://*.taleo.net/*",
        "*://successfactors.com/*", "*://*.successfactors.com/*",
        "*://recruitee.com/*", "*://*.recruitee.com/*",
        "*://workable.com/*", "*://*.workable.com/*",
        "*://breezy.hr/*", "*://*.breezy.hr/*",
        "*://pinpoint.one/*", "*://*.pinpoint.one/*",
        "*://dover.io/*", "*://*.dover.io/*",
        "*://rippling.com/*", "*://*.rippling.com/*"
      ],
      "js": ["field_registry.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "pdf.min.js",
        "pdf.worker.min.js",
        "mammoth.browser.min.js",
        "icons/*.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icon.png",
    "48": "icon48.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "feelcv@domainunknown.com",
      "strict_min_version": "109.0"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
